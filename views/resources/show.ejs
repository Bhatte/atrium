<%- include('../partials/head', { title: resource.title }) %>
<%- include('../partials/nav', { active: 'resources', currentUser: currentUser }) %>
<main id="main-content" class="page-shell reading-shell">
  <a class="back-link" href="/resources"><span aria-hidden="true">←</span> All documents</a>
  <article class="document-page">
    <header class="document-header">
      <p class="eyebrow"><%= resource.category %> document</p>
      <h1><%= resource.title %></h1>
    </header>
    <div class="document-layout">
      <div class="document-body"><p><%- resource.description %></p></div>
      <dl class="document-meta">
        <div><dt>Kept by</dt><dd><%= resource.owner_name %></dd></div>
        <div><dt>Department</dt><dd><%= resource.category %></dd></div>
        <div><dt>Record ID</dt><dd><%= resource.id %></dd></div>
      </dl>
    </div>
  </article>
</main>
<%- include('../partials/foot') %>