<%- include('../partials/head', { title: 'My profile' }) %>
<%- include('../partials/nav', { active: 'profile', currentUser: currentUser }) %>
<main id="main-content" class="page-shell">
  <section class="page-heading profile-heading">
    <p class="eyebrow">Account and identity</p>
    <h1>My profile</h1>
    <p class="hero-copy">The details colleagues use to recognise and reach you.</p>
  </section>

  <% if (typeof saved !== 'undefined' && saved) { %>
    <div class="message message-success" role="status">Your profile has been saved.</div>
  <% } %>

  <div class="profile-layout">
    <aside class="profile-card">
      <span class="profile-monogram" aria-hidden="true"><%= currentUser.display_name.split(' ').map(function (part) { return part.charAt(0); }).join('').slice(0, 2) %></span>
      <p class="eyebrow">Atrium colleague</p>
      <h2 id="profile-name"><%= currentUser.display_name %></h2>
      <p id="profile-department" class="profile-department"><%= currentUser.department %></p>
      <dl class="profile-facts">
        <div><dt>Username</dt><dd><%= currentUser.username %></dd></div>
        <div><dt>Email</dt><dd id="profile-email"><%= currentUser.email %></dd></div>
        <div><dt>Access</dt><dd><span class="tag"><%= currentUser.role %></span></dd></div>
      </dl>
    </aside>

    <section class="form-panel" aria-labelledby="edit-profile-title">
      <p class="eyebrow">Keep it current</p>
      <h2 id="edit-profile-title">Edit your details</h2>
      <form method="post" action="/profile">
        <input type="hidden" name="userId" value="<%= currentUser.id %>">
        <div class="field">
          <label for="email">Email</label>
          <input type="text" id="email" name="email" value="<%= currentUser.email %>">
        </div>
        <div class="field">
          <label for="department">Department</label>
          <input type="text" id="department" name="department" value="<%= currentUser.department %>">
        </div>
        <div class="field">
          <label for="bio">Short biography</label>
          <textarea id="bio" name="bio"><%= currentUser.bio %></textarea>
        </div>
        <button class="button button-primary" type="submit">Save changes</button>
      </form>
    </section>
  </div>
</main>
<script src="/js/profile.js"></script>
<%- include('../partials/foot') %>